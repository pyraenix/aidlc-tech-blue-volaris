{
  "Comment": "TechBlue property onboarding — an integration component of a larger UK-market ecosystem. Started by EventBridge on raw video upload. FetchInputData (EPC/compliance from upstream app, native HTTP Task) -> InvokeVideoAgent (TechBlue in-house agent, native HTTP Task) -> GenerateDescription (Bedrock Claude, Lambda) -> human review (waitForTaskToken) -> ListingApproved -> publish-to-ecosystem Lambda hands off to the existing publishing app. The two REST integrations use Step Functions' native HTTP Task via EventBridge API Connections (the connection injects the x-api-key), so no Lambda wraps them.",
  "StartAt": "MarkProcessing",
  "States": {
    "MarkProcessing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${ListingsTable}",
        "Key": { "PK": { "S.$": "States.Format('LISTING#{}', $.listingId)" }, "SK": { "S": "META" } },
        "UpdateExpression": "SET #s = :s",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":s": { "S": "PROCESSING" } }
      },
      "ResultPath": null,
      "Next": "ResolvePropertyRef"
    },

    "ResolvePropertyRef": {
      "Comment": "propertyRef is the shared ecosystem identifier (e.g. UPRN). Fall back to listingId when the execution input did not carry one.",
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.propertyRef", "IsPresent": true, "Next": "FetchInputData" }
      ],
      "Default": "DefaultPropertyRef"
    },

    "DefaultPropertyRef": {
      "Type": "Pass",
      "Parameters": { "propertyRef.$": "$.listingId" },
      "ResultPath": "$",
      "OutputPath": "$",
      "Next": "FetchInputData"
    },

    "FetchInputData": {
      "Comment": "INTEGRATION (native HTTP Task): GET EPC/compliance from the upstream app. 404 -> proceed with empty inputs flagged for the reviewer; other non-2xx -> fail. The API Connection injects the x-api-key header.",
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${UpstreamDataBaseUrl}/properties/{}/compliance', $.propertyRef)",
        "Method": "GET",
        "Authentication": { "ConnectionArn": "${UpstreamDataConnectionArn}" },
        "Headers": { "Accept": "application/json" }
      },
      "ResultSelector": {
        "epc.$": "$.ResponseBody.epc",
        "compliance.$": "$.ResponseBody.compliance",
        "missing": false
      },
      "ResultPath": "$.upstream.inputData",
      "Retry": [
        { "ErrorEquals": ["States.Http.StatusCode.429", "States.Http.StatusCode.500", "States.Http.StatusCode.502", "States.Http.StatusCode.503", "States.Http.StatusCode.504", "States.Timeout"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.Http.StatusCode.404"], "ResultPath": "$.upstream.inputData", "Next": "InputDataMissing" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }
      ],
      "Next": "InvokeVideoAgent"
    },

    "InputDataMissing": {
      "Comment": "No upstream record yet — proceed with empty inputs; the reviewer will flag it.",
      "Type": "Pass",
      "Parameters": { "epc": null, "compliance": null, "missing": true },
      "ResultPath": "$.upstream.inputData",
      "Next": "InvokeVideoAgent"
    },

    "InvokeVideoAgent": {
      "Comment": "INTEGRATION (native HTTP Task): POST the uploaded video reference to TechBlue's in-house video->image agent; it returns extracted snapshots. The API Connection injects the x-api-key header.",
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint": "${VideoAgentBaseUrl}/extract",
        "Method": "POST",
        "Authentication": { "ConnectionArn": "${VideoAgentConnectionArn}" },
        "Headers": { "Content-Type": "application/json" },
        "RequestBody": {
          "listingId.$": "$.listingId",
          "video": { "bucket.$": "$.rawBucket", "key.$": "$.rawVideoKey" }
        }
      },
      "ResultSelector": { "snapshots.$": "$.ResponseBody.snapshots" },
      "ResultPath": "$.agent",
      "Retry": [
        { "ErrorEquals": ["States.Http.StatusCode.429", "States.Http.StatusCode.500", "States.Http.StatusCode.502", "States.Http.StatusCode.503", "States.Http.StatusCode.504", "States.Timeout"], "IntervalSeconds": 10, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }
      ],
      "Next": "ValidateSnapshots"
    },

    "ValidateSnapshots": {
      "Comment": "The agent must return at least one snapshot; otherwise fail (mirrors the old Lambda's guard).",
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.agent.snapshots[0]", "IsPresent": true, "Next": "GenerateDescription" }
      ],
      "Default": "NoSnapshots"
    },

    "NoSnapshots": {
      "Type": "Pass",
      "Parameters": { "Error": "NoSnapshots", "Cause": "video agent returned no snapshots" },
      "ResultPath": "$.error",
      "Next": "MarkFailed"
    },

    "GenerateDescription": {
      "Comment": "Bedrock Claude (vision) on the agent's snapshots + owner details + EPC/compliance -> strict JSON draft.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GenerateDescriptionFunctionArn}",
        "Payload": {
          "listingId.$": "$.listingId",
          "snapshots.$": "$.agent.snapshots",
          "ownerDetails.$": "$.ownerDetails",
          "inputData.$": "$.upstream.inputData"
        }
      },
      "ResultSelector": { "listing.$": "$.Payload.listing" },
      "ResultPath": "$.generated",
      "Retry": [
        { "ErrorEquals": ["States.TaskFailed"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }
      ],
      "Next": "SaveDraftAndRequestReview"
    },

    "SaveDraftAndRequestReview": {
      "Comment": "HUMAN-IN-THE-LOOP. waitForTaskToken pauses until a reviewer submits a decision via /review/decision (SendTaskSuccess/SendTaskFailure).",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": 604800,
      "Parameters": {
        "FunctionName": "${SubmitForReviewFunctionArn}",
        "Payload": {
          "listingId.$": "$.listingId",
          "draft.$": "$.generated.listing",
          "snapshots.$": "$.agent.snapshots",
          "inputData.$": "$.upstream.inputData",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.review",
      "Catch": [
        { "ErrorEquals": ["ReviewRejected"], "ResultPath": "$.review", "Next": "MarkRejected" },
        { "ErrorEquals": ["States.Timeout"], "ResultPath": "$.error", "Next": "NotifyReviewTimeout" }
      ],
      "Next": "MarkApproved"
    },

    "MarkApproved": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${ListingsTable}",
        "Key": { "PK": { "S.$": "States.Format('LISTING#{}', $.listingId)" }, "SK": { "S": "META" } },
        "UpdateExpression": "SET #s = :s",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":s": { "S": "APPROVED" } }
      },
      "ResultPath": null,
      "Next": "EmitListingApproved"
    },

    "EmitListingApproved": {
      "Comment": "Emits ListingApproved; the publish-to-ecosystem Lambda (EventBridge target) hands the listing to the existing publishing app.",
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${EventBusName}",
            "Source": "techblue.onboarding",
            "DetailType": "ListingApproved",
            "Detail": { "listingId.$": "$.listingId" }
          }
        ]
      },
      "ResultPath": null,
      "Next": "NotifyOwnerApproved"
    },

    "NotifyOwnerApproved": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${OwnerNotifyTopicArn}",
        "Message.$": "States.Format('Your listing {} has been approved and handed off for publishing.', $.listingId)"
      },
      "End": true
    },

    "MarkRejected": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${ListingsTable}",
        "Key": { "PK": { "S.$": "States.Format('LISTING#{}', $.listingId)" }, "SK": { "S": "META" } },
        "UpdateExpression": "SET #s = :s",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":s": { "S": "REJECTED" } }
      },
      "ResultPath": null,
      "Next": "NotifyOwnerRejected"
    },

    "NotifyOwnerRejected": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${OwnerNotifyTopicArn}",
        "Message.$": "States.Format('Your listing {} needs changes before it can be published.', $.listingId)"
      },
      "End": true
    },

    "NotifyReviewTimeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${OpsNotifyTopicArn}",
        "Message.$": "States.Format('Review for listing {} timed out after 7 days.', $.listingId)"
      },
      "Next": "MarkFailed"
    },

    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${ListingsTable}",
        "Key": { "PK": { "S.$": "States.Format('LISTING#{}', $.listingId)" }, "SK": { "S": "META" } },
        "UpdateExpression": "SET #s = :s",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":s": { "S": "FAILED" } }
      },
      "ResultPath": null,
      "Next": "FailState"
    },

    "FailState": {
      "Type": "Fail",
      "Error": "OnboardingFailed",
      "Cause": "Processing, integration, or review failed; see the listing record and execution history."
    }
  }
}
